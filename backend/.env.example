# ==============================================================================
# ResumeIQ Backend Environment Configuration
# ==============================================================================

PORT=5000
FLASK_ENV=development
DEBUG=True
SECRET_KEY=resumeiq-super-secret-jwt-key-2026-production
JWT_SECRET_KEY=resumeiq-jwt-session-secret-key-32charsmin

# Database (MongoDB connection URI or Render MongoDB service)
MONGO_URI=mongodb://localhost:27017/resumeiq
DB_NAME=resumeiq

# ==============================================================================
# BREVO TRANSACTIONAL EMAIL API CONFIGURATION (Required for OTP Emails)
# ==============================================================================
# 1. Sign up for free at: https://www.brevo.com (300 free emails/day)
# 2. Go to SMTP & API -> API Keys -> Generate a new key (starts with xkeysib-...)
# 3. Paste the API key and your account sender email below:

BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME=ResumeIQ

# CORS Allowed Frontend Origin (Local and Deployed Vercel URL)
FRONTEND_URL=http://localhost:5173

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
